    "You'll need to scan the code on your Mac to pair again. Nothing is deleted on the Mac.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll need to scan the code on your Mac to pair again. Nothing is deleted on the Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "दोबारा पेयर करने के लिए आपको अपने Mac पर कोड स्कैन करना होगा। Mac पर कुछ भी नहीं हटता।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tendrás que escanear el código en tu Mac para vincular de nuevo. No se elimina nada en el Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous devrez scanner le code sur votre Mac pour vous associer de nouveau. Rien n’est supprimé sur le Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zum erneuten Koppeln müssen Sie den Code auf Ihrem Mac scannen. Auf dem Mac wird nichts gelöscht."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "再度ペアリングするには、Macでコードをスキャンする必要があります。Mac側では何も削除されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
