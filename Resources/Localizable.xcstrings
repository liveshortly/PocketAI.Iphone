          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L'autorisation de reconnaissance vocale est nécessaire pour la saisie vocale."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आवाज़ से इनपुट देने के लिए स्पीच रिकग्निशन की अनुमति ज़रूरी है।"
