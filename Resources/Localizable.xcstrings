    "Run modern open-weights models locally on Apple Silicon. Zero cloud, zero accounts, completely offline.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moderne Open-Weights-Modelle lokal auf Apple Silicon ausführen. Keine Cloud, keine Accounts, komplett offline."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run modern open-weights models locally on Apple Silicon. Zero cloud, zero accounts, completely offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ejecuta modelos modernos de pesos abiertos localmente en Apple Silicon. Sin nube, sin cuentas, totalmente sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Exécutez des modèles modernes à poids ouverts localement sur Apple Silicon. Aucun cloud, aucun compte, entièrement hors ligne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आधुनिक ओपन-वेट मॉडल Apple Silicon पर स्थानीय रूप से चलाएँ। कोई क्लाउड नहीं, कोई अकाउंट नहीं, पूरी तरह ऑफ़लाइन।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "最新のオープンウェイトモデルを Apple Silicon 上でローカルに実行。クラウドなし、アカウントなし、完全にオフラインです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Execute modelos modernos de pesos abertos localmente no Apple Silicon. Sem nuvem, sem contas, totalmente offline."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在 Apple 芯片上本地运行现代开放权重模型。无云端、无账户，完全离线。"
          }
        }
      }
    },
    "Runs GGUF models on-device via Metal. Built into the core.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Führt GGUF-Modelle über Metal direkt auf dem Gerät aus. Im Kern integriert."
          }
        },
        "en": {
