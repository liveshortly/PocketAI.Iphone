    "Apple-managed purchases, system speech downloads, and anything you open yourself in a browser or Mail aren't counted here.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple-managed purchases, system speech downloads, and anything you open yourself in a browser or Mail aren't counted here."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apple द्वारा प्रबंधित खरीदारी, सिस्टम स्पीच डाउनलोड, और ब्राउज़र या Mail में आपके खुद खोले गए किसी भी कंटेंट की गिनती यहाँ नहीं होती।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aquí no se cuentan las compras gestionadas por Apple, las descargas de voz del sistema ni nada que abras tú mismo en un navegador o en Mail."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les achats gérés par Apple, les téléchargements vocaux du système et tout ce que vous ouvrez vous-même dans un navigateur ou dans Mail ne sont pas comptabilisés ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Von Apple verwaltete Käufe, System-Sprachdownloads und alles, was Sie selbst in einem Browser oder in Mail öffnen, werden hier nicht mitgezählt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Appleが管理する購入、システム音声のダウンロード、ブラウザやMailで自分で開いたものはここに含まれません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "由 Apple 管理的购买项目、系统语音下载，以及你自行在浏览器或邮件中打开的内容均不计入此处。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Compras gerenciadas pela Apple, downloads de fala do sistema e qualquer coisa que você abrir por conta própria em um navegador ou no Mail não são contabilizados aqui."
          }
        }
      }
    },
