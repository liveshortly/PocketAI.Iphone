    "Tap Mac in the tab bar, then Scan pairing code to point this iPhone at your Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tippe in der Tableiste auf „Mac“ und dann auf „Kopplungscode scannen“, um dieses iPhone auf deinen Mac auszurichten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Mac in the tab bar, then Scan pairing code to point this iPhone at your Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toca Mac en la barra de pestañas y luego Escanear código de emparejamiento para apuntar este iPhone a tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Touchez Mac dans la barre d'onglets, puis Scanner le code de jumelage pour associer cet iPhone à votre Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "टैब बार में Mac पर टैप करें, फिर इस iPhone को अपने Mac से जोड़ने के लिए “पेयरिंग कोड स्कैन करें” पर टैप करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "タブバーで「Mac」をタップし、「ペアリングコードをスキャン」を選んで、この iPhone を Mac に向けます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toque em Mac na barra de abas e depois em Escanear código de pareamento para apontar este iPhone para o seu Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在标签栏中轻点“Mac”，然后轻点“扫描配对码”，让这台 iPhone 指向你的 Mac。"
          }
        }
      }
    },
    "Tap a voice to hear a sample. Your choice is saved as the preferred voice for spoken replies.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tippe auf eine Stimme, um eine Probe zu hören. Deine Auswahl wird als bevorzugte Stimme für vorgelesene Antworten gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a voice to hear a sample. Your choice is saved as the preferred voice for spoken replies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toca una voz para escuchar una muestra. Tu elección se guarda como la voz preferida para las respuestas habladas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Touchez une voix pour en écouter un extrait. Votre choix est enregistré comme voix préférée pour les réponses lues à voix haute."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सैंपल सुनने के लिए किसी आवाज़ पर टैप करें। आपका चयन बोले गए उत्तरों के लिए पसंदीदा आवाज़ के रूप में सेव हो जाता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "音声をタップするとサンプルを再生します。選んだ音声は、読み上げ返信の優先音声として保存されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toque em uma voz para ouvir uma amostra. Sua escolha é salva como a voz preferida para respostas faladas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "轻点某个声音可试听样本。你的选择会保存为朗读回复的首选声音。"
          }
        }
      }
    },
