    "This isn't available with your Mac yet. Everything on this iPhone keeps working.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This isn't available with your Mac yet. Everything on this iPhone keeps working."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह अभी आपके Mac के साथ उपलब्ध नहीं है। इस iPhone पर बाकी सब कुछ पहले की तरह काम करता रहेगा।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esto aún no está disponible con tu Mac. Todo lo demás en este iPhone sigue funcionando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce n'est pas encore disponible avec votre Mac. Tout le reste continue de fonctionner sur cet iPhone."
          }
        },
        "de": {
          "stringUnit": {
