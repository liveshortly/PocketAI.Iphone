    "PocketAI does not send diagnostics automatically. You can review the exact payload below before choosing to send it to support via email. No chat content, prompts, or sensitive keys are included.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI sendet Diagnosedaten nicht automatisch. Du kannst die genauen Daten unten prüfen, bevor du sie per E-Mail an den Support sendest. Chatinhalte, Prompts und sensible Schlüssel sind nicht enthalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PocketAI does not send diagnostics automatically. You can review the exact payload below before choosing to send it to support via email. No chat content, prompts, or sensitive keys are included."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI no envía diagnósticos automáticamente. Puedes revisar los datos exactos que aparecen abajo antes de decidir si los envías al soporte por correo electrónico. No se incluye contenido de los chats, prompts ni claves sensibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI n'envoie pas de diagnostics automatiquement. Vous pouvez examiner les données exactes ci-dessous avant de décider de les envoyer à l'assistance par e-mail. Aucun contenu de discussion, prompt ou clé sensible n'est inclus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI डायग्नोस्टिक्स अपने आप नहीं भेजता। नीचे दिया गया पूरा डेटा आप ईमेल से सहायता टीम को भेजने का फ़ैसला करने से पहले देख सकते हैं। इसमें कोई चैट सामग्री, प्रॉम्प्ट या संवेदनशील कुंजियाँ शामिल नहीं हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAIは診断情報を自動的に送信しません。下に表示される送信内容を確認してから、メールでサポートに送信するかどうかを選べます。チャットの内容、プロンプト、機密キーは含まれません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O PocketAI não envia diagnósticos automaticamente. Você pode revisar os dados exatos abaixo antes de decidir enviá-los ao suporte por e-mail. Nenhum conteúdo de chat, prompt ou chave sensível está incluído."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI 不会自动发送诊断信息。你可以先查看下面的完整内容，再决定是否通过电子邮件发送给支持团队。其中不包含任何聊天内容、提示词或敏感密钥。"
          }
        }
      }
    },
    "PocketAI is unavailable": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI ist nicht verfügbar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PocketAI is unavailable"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI no está disponible"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI est indisponible"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI उपलब्ध नहीं है"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAIを利用できません"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O PocketAI está indisponível"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI 不可用"
          }
        }
      }
    },
    "PocketAI made %lld internet request%@ since this app launched.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI hat seit dem Start dieser App %lld Internetanfrage%@ gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PocketAI made %1$lld internet request%2$@ since this app launched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI ha hecho %lld solicitud%@ de internet desde que se abrió la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI a effectué %lld requête%@ internet depuis le lancement de l'app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस ऐप के शुरू होने के बाद PocketAI ने %lld इंटरनेट अनुरोध%@ किए।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このアプリの起動以降、PocketAIは%lld件のインターネットリクエスト%@を送信しました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O PocketAI fez %lld solicitação%@ de internet desde que o app foi aberto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "自本应用启动以来，PocketAI 共发起了 %lld 次互联网请求%@。"
          }
        }
      }
    },
    "PocketAI needs permission to save generated images to your photo library. You can grant access in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI benötigt die Berechtigung, generierte Bilder in deiner Fotomediathek zu speichern. Du kannst den Zugriff in den Einstellungen erteilen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PocketAI needs permission to save generated images to your photo library. You can grant access in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI necesita permiso para guardar las imágenes generadas en tu fototeca. Puedes conceder el acceso en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI a besoin d'une autorisation pour enregistrer les images générées dans votre photothèque. Vous pouvez l'accorder dans Réglages."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "बनाई गई इमेज आपकी फ़ोटो लाइब्रेरी में सहेजने के लिए PocketAI को अनुमति चाहिए। आप सेटिंग्स में एक्सेस दे सकते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "生成した画像を写真ライブラリに保存するには、PocketAIに許可が必要です。「設定」でアクセスを許可できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O PocketAI precisa de permissão para salvar as imagens geradas na sua biblioteca de fotos. Você pode conceder o acesso em Ajustes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI 需要获得权限才能将生成的图片保存到你的照片图库。你可以在“设置”中授予访问权限。"
          }
        }
      }
    },
    "PocketAI picks the right engine for each model automatically.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI wählt für jedes Modell automatisch die passende Engine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PocketAI picks the right engine for each model automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI elige automáticamente el motor adecuado para cada modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI choisit automatiquement le moteur adapté à chaque modèle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI हर मॉडल के लिए सही इंजन अपने आप चुन लेता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAIは各モデルに最適なエンジンを自動的に選択します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O PocketAI escolhe automaticamente o motor adequado para cada modelo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI 会自动为每个模型选择合适的引擎。"
          }
        }
      }
    },
    "PocketAI uses the camera to scan your Mac's pairing code and Local Network access to connect to it. Everything stays on your local network.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI verwendet die Kamera, um den Kopplungscode deines Mac zu scannen, und den Zugriff auf das lokale Netzwerk, um sich damit zu verbinden. Alles bleibt in deinem lokalen Netzwerk."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PocketAI uses the camera to scan your Mac's pairing code and Local Network access to connect to it. Everything stays on your local network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI usa la cámara para escanear el código de vinculación de tu Mac y el acceso a la red local para conectarse a él. Todo permanece en tu red local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI utilise l'appareil photo pour scanner le code de jumelage de votre Mac et l'accès au réseau local pour s'y connecter. Tout reste sur votre réseau local."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI आपके Mac का पेयरिंग कोड स्कैन करने के लिए कैमरे का और उससे कनेक्ट करने के लिए लोकल नेटवर्क एक्सेस का उपयोग करता है। सब कुछ आपके लोकल नेटवर्क पर ही रहता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAIは、Macのペアリングコードを読み取るためにカメラを使用し、Macに接続するためにローカルネットワークへのアクセスを使用します。すべてはローカルネットワーク内に留まります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O PocketAI usa a câmera para escanear o código de pareamento do seu Mac e o acesso à rede local para se conectar a ele. Tudo permanece na sua rede local."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI 使用相机扫描你的 Mac 的配对码，并使用本地网络访问权限与其连接。所有内容都保留在你的本地网络中。"
          }
        }
      }
    },
    "PocketAI uses the microphone and on-device speech recognition to turn your voice into text. Audio is transcribed on this iPhone and never leaves it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI verwendet das Mikrofon und die Spracherkennung auf dem Gerät, um deine Stimme in Text umzuwandeln. Audio wird auf diesem iPhone transkribiert und verlässt es nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PocketAI uses the microphone and on-device speech recognition to turn your voice into text. Audio is transcribed on this iPhone and never leaves it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI usa el micrófono y el reconocimiento de voz en el dispositivo para convertir tu voz en texto. El audio se transcribe en este iPhone y nunca sale de él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI utilise le micro et la reconnaissance vocale sur l'appareil pour convertir votre voix en texte. L'audio est transcrit sur cet iPhone et n'en sort jamais."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI आपकी आवाज़ को टेक्स्ट में बदलने के लिए माइक्रोफ़ोन और डिवाइस पर ही चलने वाली स्पीच रिकग्निशन का उपयोग करता है। ऑडियो इसी iPhone पर ट्रांसक्राइब होता है और इसे कभी नहीं छोड़ता।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAIは、音声をテキストに変換するためにマイクとデバイス上の音声認識を使用します。音声はこのiPhone上で文字起こしされ、デバイスの外に出ることはありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O PocketAI usa o microfone e o reconhecimento de fala no dispositivo para transformar sua voz em texto. O áudio é transcrito neste iPhone e nunca sai dele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI 使用麦克风和设备端语音识别，将你的语音转换为文字。音频在这台 iPhone 上转写，绝不会离开设备。"
          }
        }
      }
    },
    "PocketAI's on-device engine couldn't start. Please restart the app; if it keeps happening, reinstall. (%@)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die On-Device-Engine von PocketAI konnte nicht gestartet werden. Starte die App neu; wenn das Problem weiterhin auftritt, installiere sie neu. (%@)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PocketAI's on-device engine couldn't start. Please restart the app; if it keeps happening, reinstall. (%@)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El motor en el dispositivo de PocketAI no pudo iniciarse. Reinicia la app; si sigue ocurriendo, vuelve a instalarla. (%@)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le moteur sur l'appareil de PocketAI n'a pas pu démarrer. Relancez l'app ; si le problème persiste, réinstallez-la. (%@)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI का ऑन-डिवाइस इंजन शुरू नहीं हो सका। कृपया ऐप को फिर से शुरू करें; अगर यह बार-बार हो, तो दोबारा इंस्टॉल करें। (%@)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAIのオンデバイスエンジンを起動できませんでした。アプリを再起動してください。繰り返し発生する場合は再インストールしてください。（%@）"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O motor no dispositivo do PocketAI não conseguiu iniciar. Reinicie o app; se continuar acontecendo, reinstale-o. (%@)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI 的设备端引擎无法启动。请重新启动应用；如果问题持续出现，请重新安装。（%@）"
          }
        }
      }
    },
    "Point this iPhone camera at your Mac screen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Richte die Kamera dieses iPhone auf den Bildschirm deines Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point this iPhone camera at your Mac screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apunta la cámara de este iPhone a la pantalla de tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pointez l'appareil photo de cet iPhone vers l'écran de votre Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस iPhone के कैमरे को अपने Mac की स्क्रीन की ओर रखें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このiPhoneのカメラをMacの画面に向けてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aponte a câmera deste iPhone para a tela do seu Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将这台 iPhone 的相机对准你的 Mac 屏幕。"
          }
        }
      }
    },
