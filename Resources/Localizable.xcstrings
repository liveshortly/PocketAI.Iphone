    "The on-device engine couldn't start. Your chats and models are safe on this iPhone. Please restart the app to try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die On-Device-Engine konnte nicht starten. Deine Chats und Modelle sind auf diesem iPhone sicher. Starte die App neu, um es erneut zu versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The on-device engine couldn't start. Your chats and models are safe on this iPhone. Please restart the app to try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se pudo iniciar el motor en el dispositivo. Tus chats y modelos están a salvo en este iPhone. Reinicia la app para volver a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le moteur sur l'appareil n'a pas pu démarrer. Vos chats et vos modèles sont intacts sur cet iPhone. Redémarrez l'app pour réessayer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ऑन-डिवाइस इंजन शुरू नहीं हो सका। आपकी चैट और मॉडल इस iPhone पर सुरक्षित हैं। दोबारा कोशिश करने के लिए ऐप को रीस्टार्ट करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "オンデバイスエンジンを起動できませんでした。チャットとモデルはこのiPhoneに安全に保存されています。アプリを再起動してやり直してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível iniciar o mecanismo no dispositivo. Seus chats e modelos estão seguros neste iPhone. Reinicie o app para tentar novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "设备端引擎无法启动。你的聊天和模型都安全地保存在这台 iPhone 上。请重新启动应用后再试。"
          }
        }
      }
    },
    "The quick brown fox jumps over the lazy dog.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Franz jagt im komplett verwahrlosten Taxi quer durch Bayern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The quick brown fox jumps over the lazy dog."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El veloz murciélago hindú comía feliz cardillo y kiwi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Portez ce vieux whisky au juge blond qui fume."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तेज़ भूरी लोमड़ी आलसी कुत्ते के ऊपर से कूद जाती है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "いろはにほへと ちりぬるを わかよたれそ つねならむ。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um pequeno jabuti xereta viu dez cegonhas felizes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "敏捷的棕色狐狸跃过那只懒狗。"
          }
        }
      }
    },
    "The selected model isn't installed. Choose another.": {
      "localizations": {
        "de": {
