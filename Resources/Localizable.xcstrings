    "Code stays on this iPhone, or goes to your own Mac if you turn on Run on my Mac. Web search sends only the query or page you allow to the web.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Code stays on this iPhone, or goes to your own Mac if you turn on Run on my Mac. Web search sends only the query or page you allow to the web."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कोड इसी iPhone पर रहता है, या “Run on my Mac” चालू करने पर आपके अपने Mac पर जाता है। वेब खोज केवल वही क्वेरी या पेज वेब को भेजती है जिसकी आप अनुमति देते हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El código se queda en este iPhone, o va a tu propio Mac si activas Run on my Mac. La búsqueda web solo envía a la web la consulta o página que permites."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le code reste sur cet iPhone, ou va sur votre propre Mac si vous activez Run on my Mac. La recherche web n'envoie au web que la requête ou la page que vous autorisez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Code bleibt auf diesem iPhone oder geht an deinen eigenen Mac, wenn du Run on my Mac einschaltest. Die Websuche sendet nur die Anfrage oder Seite ins Web, die du erlaubst."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "コードはこのiPhoneに残ります。Run on my Macをオンにした場合は、お使いのMacに送られます。Web検索では、許可したクエリまたはページだけがWebに送信されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "代码保留在这部 iPhone 上；如果你打开 Run on my Mac，则会发送到你自己的 Mac。网页搜索只会把你允许的查询或页面发送到网络。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O código fica neste iPhone ou vai para o seu próprio Mac se você ativar Run on my Mac. A busca na web envia apenas a consulta ou página que você permitir."
          }
        }
      }
    },
