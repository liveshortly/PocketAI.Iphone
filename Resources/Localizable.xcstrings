    "Chat sync isn't available with this Mac yet. Your chats stay on this iPhone until then.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat sync isn't available with this Mac yet. Your chats stay on this iPhone until then."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "चैट सिंक अभी इस Mac के साथ उपलब्ध नहीं है। तब तक आपकी चैट इसी iPhone पर रहेंगी।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La sincronización de chats aún no está disponible con este Mac. Hasta entonces, tus chats se quedan en este iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La synchronisation des chats n'est pas encore disponible avec ce Mac. D'ici là, vos chats restent sur cet iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Chat-Synchronisierung ist mit diesem Mac noch nicht verfügbar. Bis dahin bleiben deine Chats auf diesem iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このMacではまだチャット同期を利用できません。それまでチャットはこのiPhoneに残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此 Mac 暂不支持聊天同步。在此之前，你的聊天会保留在这部 iPhone 上。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A sincronização de chats ainda não está disponível com este Mac. Até lá, seus chats ficam neste iPhone."
          }
        }
      }
    },
