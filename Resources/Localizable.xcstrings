    "Offline mode is on — turn it off in Settings to search Hugging Face.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Offline-Modus ist aktiviert – deaktiviere ihn in den Einstellungen, um Hugging Face zu durchsuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline mode is on — turn it off in Settings to search Hugging Face."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El modo sin conexión está activado: desactívalo en Ajustes para buscar en Hugging Face."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le mode hors ligne est activé — désactivez-le dans Réglages pour effectuer une recherche sur Hugging Face."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ऑफ़लाइन मोड चालू है — Hugging Face पर खोजने के लिए इसे सेटिंग्स में बंद करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "オフラインモードがオンです。Hugging Face を検索するには、設定でオフにしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O modo offline está ativado — desative-o em Ajustes para buscar no Hugging Face."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "离线模式已开启 — 请在“设置”中关闭后搜索 Hugging Face。"
          }
        }
      }
    },
