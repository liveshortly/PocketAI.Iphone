      }
    },
    "Apple-managed purchases, system speech downloads, and anything you open yourself in a browser or Mail aren't counted here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Von Apple verwaltete Einkäufe, Sprachdownloads des Systems und alles, was du selbst in einem Browser oder in Mail öffnest, werden hier nicht gezählt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple-managed purchases, system speech downloads, and anything you open yourself in a browser or Mail aren't counted here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las compras gestionadas por Apple, las descargas de voz del sistema y todo lo que abras tú mismo en un navegador o en Mail no se cuentan aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les achats gérés par Apple, les téléchargements vocaux du système et tout ce que vous ouvrez vous-même dans un navigateur ou dans Mail ne sont pas comptés ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apple द्वारा प्रबंधित खरीदारी, सिस्टम के वाक् डाउनलोड, और ब्राउज़र या Mail में आपके द्वारा स्वयं खोली गई चीज़ें यहाँ नहीं गिनी जातीं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apple が管理する購入、システムの音声データのダウンロード、ブラウザや Mail で自分で開いたものは、ここには含まれません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Compras gerenciadas pela Apple, downloads de voz do sistema e qualquer coisa que você abra por conta própria em um navegador ou no Mail não são contabilizados aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "由 Apple 管理的购买项目、系统语音下载，以及你自己在浏览器或 Mail 中打开的内容，均不计入此处。"
          }
        }
      }
    },
