    "Pair over local Wi-Fi to run your Mac's larger models from this iPhone. Everything stays on your devices.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair over local Wi-Fi to run your Mac's larger models from this iPhone. Everything stays on your devices."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस iPhone से अपने Mac के बड़े मॉडल चलाने के लिए लोकल Wi-Fi से पेयर करें। सब कुछ आपके डिवाइस पर ही रहता है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vincula por Wi-Fi local para usar desde este iPhone los modelos más grandes de tu Mac. Todo se queda en tus dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Associez-vous via le Wi-Fi local pour exécuter les plus grands modèles de votre Mac depuis cet iPhone. Tout reste sur vos appareils."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Koppeln Sie über lokales Wi-Fi, um die größeren Modelle Ihres Mac von diesem iPhone aus zu nutzen. Alles bleibt auf Ihren Geräten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ローカルWi-Fiでペアリングすると、このiPhoneからMacの大きなモデルを実行できます。すべてお使いのデバイス内にとどまります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "通过本地 Wi-Fi 配对，即可在这部 iPhone 上运行你 Mac 上更大的模型。所有内容都只保留在你的设备上。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pareie por Wi-Fi local para executar os modelos maiores do seu Mac a partir deste iPhone. Tudo fica nos seus dispositivos."
          }
        }
      }
    },
