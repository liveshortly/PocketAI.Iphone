    "We read this on your device. It is never sent anywhere.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wir lesen das auf deinem Gerät. Es wird nie irgendwohin gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We read this on your device. It is never sent anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Leemos esto en tu dispositivo. Nunca se envía a ningún sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nous lisons ceci sur votre appareil. Rien n'est jamais envoyé ailleurs."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हम इसे आपके डिवाइस पर पढ़ते हैं। इसे कहीं भी नहीं भेजा जाता।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この内容はお使いのデバイス上で読み取られます。どこにも送信されません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lemos isso no seu dispositivo. Nada é enviado para fora."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "我们在你的设备上读取此内容。它不会被发送到任何地方。"
          }
        }
      }
    },
    "We test fit on your device before downloading.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wir prüfen vor dem Download, ob es auf dein Gerät passt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We test fit on your device before downloading."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Antes de descargarlo, comprobamos si cabe en tu dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Avant le téléchargement, nous vérifions qu'il tient sur votre appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "डाउनलोड करने से पहले हम जाँचते हैं कि यह आपके डिवाइस पर फ़िट होता है या नहीं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ダウンロードの前に、お使いのデバイスに収まるかを確認します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Antes de baixar, testamos se cabe no seu dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
