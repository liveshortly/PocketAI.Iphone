    "Running code is off; allow it in Settings → Tools.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running code is off; allow it in Settings → Tools."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कोड चलाना बंद है; इसे सेटिंग्स → टूल्स में अनुमति दें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La ejecución de código está desactivada; permítela en Ajustes → Herramientas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’exécution de code est désactivée ; autorisez-la dans Réglages → Outils."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Codeausführung ist aus; erlauben Sie sie unter Einstellungen → Tools."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "コードの実行はオフです。設定 → ツールで許可してください。"
          }
        },
        "zh-Hans": {
