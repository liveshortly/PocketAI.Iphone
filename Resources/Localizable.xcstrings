    "Make sure your Mac shows the same number, then click Allow there. If it's different, click Deny.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure your Mac shows the same number, then click Allow there. If it's different, click Deny."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जाँच लें कि आपके Mac पर वही नंबर दिख रहा है, फिर वहाँ Allow पर क्लिक करें। अलग हो तो Deny पर क्लिक करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comprueba que tu Mac muestre el mismo número y haz clic en Allow allí. Si es distinto, haz clic en Deny."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vérifiez que votre Mac affiche le même numéro, puis cliquez sur Allow. S'il est différent, cliquez sur Deny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prüfe, ob dein Mac dieselbe Zahl anzeigt, und klicke dort auf Allow. Ist sie anders, klicke auf Deny."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Macに同じ番号が表示されていることを確認し、Mac側でAllowをクリックしてください。違う場合はDenyをクリックしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请确认你的 Mac 上显示相同的数字，然后在 Mac 上点击 Allow。如果不同，请点击 Deny。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Confira se o seu Mac mostra o mesmo número e clique em Allow lá. Se for diferente, clique em Deny."
          }
        }
      }
    },
