    "Apple Mail is not configured on this device. You can copy the report and email it manually to support@pocket.liveshortly.com.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Mail is not configured on this device. You can copy the report and email it manually to support@pocket.liveshortly.com."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस डिवाइस पर Apple Mail सेट अप नहीं है। आप रिपोर्ट कॉपी करके support@pocket.liveshortly.com पर खुद ईमेल कर सकते हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apple Mail no está configurado en este dispositivo. Puedes copiar el informe y enviarlo manualmente por correo a support@pocket.liveshortly.com."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apple Mail n’est pas configuré sur cet appareil. Vous pouvez copier le rapport et l’envoyer manuellement par e-mail à support@pocket.liveshortly.com."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apple Mail ist auf diesem Gerät nicht eingerichtet. Sie können den Bericht kopieren und manuell an support@pocket.liveshortly.com senden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このデバイスではApple Mailが設定されていません。レポートをコピーして、support@pocket.liveshortly.com まで手動でメール送信してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此设备尚未设置“邮件”。你可以复制报告，并手动发送电子邮件至 support@pocket.liveshortly.com。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Apple Mail não está configurado neste dispositivo. Você pode copiar o relatório e enviá-lo por e-mail manualmente para support@pocket.liveshortly.com."
          }
        }
      }
    },
