    "Speech recognition permission has been denied. Please enable it in Settings to transcribe voice input.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Berechtigung für die Spracherkennung wurde verweigert. Aktiviere sie in den Einstellungen, um Spracheingaben zu transkribieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recognition permission has been denied. Please enable it in Settings to transcribe voice input."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se denegó el permiso de reconocimiento de voz. Actívalo en Ajustes para transcribir la entrada de voz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L'autorisation de reconnaissance vocale a été refusée. Activez-la dans Réglages pour transcrire la saisie vocale."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्पीच रिकग्निशन की अनुमति नहीं दी गई है। आवाज़ के इनपुट को टेक्स्ट में बदलने के लिए इसे सेटिंग्स में चालू करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "音声認識の許可が拒否されています。音声入力を文字に変換するには、「設定」で許可してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A permissão de reconhecimento de voz foi recusada. Ative-a nos Ajustes para transcrever a entrada de voz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "语音识别权限已被拒绝。请在“设置”中开启，以便转写语音输入。"
          }
        }
      }
    },
    "Speech recognition permission is required for voice input.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
