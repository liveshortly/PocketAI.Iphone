    "Pairing uses the camera, so it runs from the Mac tab. Everything stays on your devices.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing uses the camera, so it runs from the Mac tab. Everything stays on your devices."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पेयरिंग में कैमरे का उपयोग होता है, इसलिए यह Mac टैब से चलती है। सब कुछ आपके डिवाइस पर ही रहता है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La vinculación usa la cámara, así que se hace desde la pestaña Mac. Todo se queda en tus dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’association utilise la caméra ; elle se fait depuis l’onglet Mac. Tout reste sur vos appareils."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Koppeln nutzt die Kamera und läuft daher über den Tab „Mac“. Alles bleibt auf Ihren Geräten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ペアリングにはカメラを使うため、Macタブから行います。すべてお使いのデバイス内にとどまります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "配对需要使用相机，因此请在 Mac 标签页中进行。所有内容都只保留在你的设备上。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O pareamento usa a câmera, então é feito na aba Mac. Tudo fica nos seus dispositivos."
          }
        }
      }
    },
