    "Voice input is transcribed with Apple's Speech framework. When on-device recognition is supported, your audio stays on this iPhone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Spracheingabe wird mit Apples Speech-Framework transkribiert. Wenn die Erkennung auf dem Gerät unterstützt wird, bleibt dein Audio auf diesem iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice input is transcribed with Apple's Speech framework. When on-device recognition is supported, your audio stays on this iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La entrada de voz se transcribe con el framework Speech de Apple. Cuando el reconocimiento en el dispositivo es compatible, tu audio no sale de este iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La saisie vocale est transcrite avec le framework Speech d'Apple. Lorsque la reconnaissance sur l'appareil est prise en charge, votre audio ne quitte pas cet iPhone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आवाज़ इनपुट को Apple के Speech फ़्रेमवर्क से ट्रांसक्राइब किया जाता है। जब डिवाइस पर पहचान समर्थित होती है, तो आपका ऑडियो इसी iPhone पर रहता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "音声入力はAppleのSpeechフレームワークで文字起こしされます。デバイス上での認識がサポートされている場合、音声はこのiPhoneから外に出ません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A entrada de voz é transcrita com o framework Speech da Apple. Quando o reconhecimento no dispositivo é compatível, seu áudio permanece neste iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "语音输入通过 Apple 的 Speech 框架转写。在支持设备端识别时，你的音频不会离开这台 iPhone。"
          }
        }
      }
    },
