    "Shows models too large for this iPhone and lets you download them. They may run very slowly or crash the app.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows models too large for this iPhone and lets you download them. They may run very slowly or crash the app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस iPhone के लिए बहुत बड़े मॉडल दिखाता है और उन्हें डाउनलोड करने देता है। वे बहुत धीमे चल सकते हैं या ऐप क्रैश कर सकते हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Muestra modelos demasiado grandes para este iPhone y permite descargarlos. Pueden ir muy lentos o cerrar la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Affiche les modèles trop volumineux pour cet iPhone et permet de les télécharger. Ils peuvent être très lents ou faire planter l'app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zeigt Modelle, die für dieses iPhone zu groß sind, und erlaubt den Download. Sie laufen eventuell sehr langsam oder bringen die App zum Absturz."
          }
        },
