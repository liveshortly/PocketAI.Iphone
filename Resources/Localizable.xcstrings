    "PocketAI asks once. You can change it later in iOS Settings.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PocketAI asks once. You can change it later in iOS Settings."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI एक बार पूछता है। आप इसे बाद में iOS सेटिंग्स में बदल सकते हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI lo pregunta una sola vez. Puedes cambiarlo después en Ajustes de iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI ne demande qu'une fois. Vous pourrez le modifier plus tard dans les Réglages iOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI fragt nur einmal. Du kannst es später in den iOS-Einstellungen ändern."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAIが確認するのは一度だけです。あとでiOSの設定から変更できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI 只会询问一次。你之后可以在 iOS 设置中更改。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O PocketAI pergunta só uma vez. Você pode mudar depois nos Ajustes do iOS."
          }
        }
      }
    },
    "PocketAI does not send diagnostics automatically. You can review the exact payload below before choosing to send it to support via email. No chat content, prompts, or sensitive keys are included.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PocketAI does not send diagnostics automatically. You can review the exact payload below before choosing to send it to support via email. No chat content, prompts, or sensitive keys are included."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI डायग्नोस्टिक अपने-आप नहीं भेजता। सपोर्ट को ईमेल से भेजने का फ़ैसला करने से पहले आप नीचे दिया गया पूरा पेलोड देख सकते हैं। इसमें चैट की सामग्री, प्रॉम्प्ट या संवेदनशील कुंजियाँ शामिल नहीं हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI no envía diagnósticos automáticamente. Puedes revisar abajo el contenido exacto antes de decidir enviarlo a soporte por correo. No se incluye contenido de chats, prompts ni claves sensibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI n’envoie aucun diagnostic automatiquement. Vous pouvez vérifier ci-dessous le contenu exact avant de choisir de l’envoyer au support par e-mail. Aucun contenu de discussion, aucune requête ni clé sensible n’est inclus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI sendet keine Diagnosedaten automatisch. Sie können die genauen Daten unten prüfen, bevor Sie sich entscheiden, sie per E-Mail an den Support zu senden. Chatinhalte, Prompts und sensible Schlüssel sind nicht enthalten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAIは診断情報を自動送信しません。メールでサポートに送信する前に、下の内容を正確に確認できます。チャット内容、プロンプト、機密キーは含まれません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI 不会自动发送诊断信息。你可以先查看下方的确切内容，再决定是否通过电子邮件发送给支持团队。其中不包含对话内容、提示词或敏感密钥。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O PocketAI não envia diagnósticos automaticamente. Você pode revisar o payload exato abaixo antes de decidir enviá-lo ao suporte por e-mail. Nenhum conteúdo de conversa, prompt ou chave sensível é incluído."
          }
        }
      }
    },
