    "Sends a fixed question with the Tools button on and shows which tools the model was offered and what it answered. Needs a model on this iPhone.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends a fixed question with the Tools button on and shows which tools the model was offered and what it answered. Needs a model on this iPhone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "टूल्स बटन चालू रखकर एक तय सवाल भेजता है और दिखाता है कि मॉडल को कौन से टूल दिए गए और उसने क्या जवाब दिया। इसके लिए इस iPhone पर एक मॉडल चाहिए।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Envía una pregunta fija con el botón Herramientas activado y muestra qué herramientas se ofrecieron al modelo y qué respondió. Requiere un modelo en este iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Envoie une question fixe avec le bouton Outils activé et montre quels outils ont été proposés au modèle et ce qu’il a répondu. Nécessite un modèle sur cet iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sendet eine feste Frage bei aktivierter Taste „Tools“ und zeigt, welche Tools dem Modell angeboten wurden und was es geantwortet hat. Erfordert ein Modell auf diesem iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ツールボタンをオンにして定型の質問を送信し、モデルに提供されたツールと回答を表示します。このiPhone内のモデルが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在开启“工具”按钮的情况下发送一个固定问题，并显示提供给模型的工具及其回答。需要这部 iPhone 上有模型。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Envia uma pergunta fixa com o botão Ferramentas ativado e mostra quais ferramentas foram oferecidas ao modelo e o que ele respondeu. Requer um modelo neste iPhone."
          }
        }
      }
    },
