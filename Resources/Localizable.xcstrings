    "Removes the pairing and this Mac's models. You'll need to scan its code again to reconnect.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Entfernt die Kopplung und die Modelle dieses Mac. Zum erneuten Verbinden musst du seinen Code noch einmal scannen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes the pairing and this Mac's models. You'll need to scan its code again to reconnect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quita el emparejamiento y los modelos de este Mac. Tendrás que volver a escanear su código para reconectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Supprime le jumelage et les modèles de ce Mac. Vous devrez scanner son code à nouveau pour vous reconnecter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पेयरिंग और इस Mac के मॉडल हटा देता है। फिर कनेक्ट करने के लिए आपको इसका कोड दोबारा स्कैन करना होगा।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ペアリングとこの Mac のモデルを削除します。再接続するには、コードをもう一度スキャンする必要があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Remove o pareamento e os modelos deste Mac. Você precisará escanear o código dele novamente para reconectar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将移除配对以及这台 Mac 的模型。要重新连接，需要再次扫描它的代码。"
          }
        }
      }
    },
