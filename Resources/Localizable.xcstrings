    "No voices for your language are installed. Add them in iOS Settings → Accessibility → Spoken Content → Voices.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Für deine Sprache sind keine Stimmen installiert. Füge sie in den iOS-Einstellungen → Bedienungshilfen → Gesprochene Inhalte → Stimmen hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No voices for your language are installed. Add them in iOS Settings → Accessibility → Spoken Content → Voices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No hay voces instaladas para tu idioma. Añádelas en Ajustes de iOS → Accesibilidad → Contenido leído → Voces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucune voix n’est installée pour votre langue. Ajoutez-les dans Réglages iOS → Accessibilité → Contenu énoncé → Voix."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपकी भाषा के लिए कोई आवाज़ इंस्टॉल नहीं है। उन्हें iOS सेटिंग्ज़ → ऐक्सेसिबिलिटी → बोली जाने वाली सामग्री → आवाज़ें में जोड़ें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "お使いの言語の音声がインストールされていません。iOSの「設定」→「アクセシビリティ」→「読み上げコンテンツ」→「声」で追加してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhuma voz para o seu idioma está instalada. Adicione em Ajustes do iOS → Acessibilidade → Conteúdo Falado → Vozes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未安装你所用语言的朗读语音。请在 iOS“设置”→“辅助功能”→“朗读内容”→“人声”中添加。"
