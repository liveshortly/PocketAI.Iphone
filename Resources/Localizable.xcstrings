    "This permanently deletes the conversation and its messages.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Damit werden die Unterhaltung und ihre Nachrichten endgültig gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes the conversation and its messages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esto elimina permanentemente la conversación y sus mensajes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette action supprime définitivement la conversation et ses messages."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इससे बातचीत और उसके संदेश हमेशा के लिए मिट जाएँगे।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この操作で、会話とそのメッセージが完全に削除されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Isso exclui permanentemente a conversa e suas mensagens."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这将永久删除该对话及其消息。"
          }
