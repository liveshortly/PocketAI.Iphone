    "Chat sync with your paired Mac shows here as “To your Mac”. Other connections to it are listed in the Mac tab.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat sync with your paired Mac shows here as “To your Mac”. Other connections to it are listed in the Mac tab."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पेयर किए गए Mac के साथ चैट सिंक यहाँ “आपके Mac को” के रूप में दिखता है। इसके अन्य कनेक्शन Mac टैब में सूचीबद्ध हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La sincronización de chats con tu Mac vinculado aparece aquí como “A tu Mac”. Las demás conexiones con él se muestran en la pestaña Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La synchronisation des discussions avec votre Mac associé apparaît ici sous « Vers votre Mac ». Les autres connexions à celui-ci sont listées dans l’onglet Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Chat-Abgleich mit Ihrem gekoppelten Mac erscheint hier als „An Ihren Mac“. Andere Verbindungen dazu finden Sie im Tab „Mac“."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ペアリング済みMacとのチャット同期は、ここに「Macへ」と表示されます。その他の接続はMacタブに一覧表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "与已配对 Mac 的对话同步在此显示为“发送到你的 Mac”。其他连接则列在 Mac 标签页中。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A sincronização de conversas com seu Mac pareado aparece aqui como “Para o seu Mac”. As outras conexões com ele ficam listadas na aba Mac."
