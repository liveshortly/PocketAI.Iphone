    "Tap a voice to hear a sample. Your choice is saved as the preferred voice for spoken replies.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a voice to hear a sample. Your choice is saved as the preferred voice for spoken replies."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "नमूना सुनने के लिए किसी आवाज़ पर टैप करें। आपकी पसंद बोले गए जवाबों की पसंदीदा आवाज़ के रूप में सहेजी जाती है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toca una voz para escuchar una muestra. Tu elección se guarda como la voz preferida para las respuestas habladas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Touchez une voix pour en entendre un extrait. Votre choix est enregistré comme voix préférée pour les réponses lues."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tippen Sie auf eine Stimme, um eine Hörprobe zu hören. Ihre Auswahl wird als bevorzugte Stimme für gesprochene Antworten gesichert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "音声をタップするとサンプルを聞けます。選んだ音声が返信の読み上げ用として保存されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "轻点语音即可试听。你的选择将存储为朗读回复的首选语音。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toque em uma voz para ouvir uma amostra. Sua escolha é salva como a voz preferida para respostas faladas."
          }
        }
      }
    },
