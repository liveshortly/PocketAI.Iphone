    "Pair over local Wi-Fi to run larger models using your Mac's unified memory. Everything stays on your devices.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kopple über lokales WLAN, um mit der Unified Memory deines Mac größere Modelle auszuführen. Alles bleibt auf deinen Geräten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair over local Wi-Fi to run larger models using your Mac's unified memory. Everything stays on your devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Empareja por Wi-Fi local para ejecutar modelos más grandes con la memoria unificada de tu Mac. Todo permanece en tus dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jumelez via le Wi-Fi local pour exécuter des modèles plus grands grâce à la mémoire unifiée de votre Mac. Tout reste sur vos appareils."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अपने Mac की यूनिफ़ाइड मेमोरी से बड़े मॉडल चलाने के लिए लोकल Wi-Fi पर पेयर करें। सब कुछ आपके डिवाइस पर ही रहता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ローカル Wi-Fi でペアリングすると、Mac のユニファイドメモリを使って大きいモデルを実行できます。すべてお使いのデバイス内に留まります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pareie pelo Wi-Fi local para rodar modelos maiores usando a memória unificada do seu Mac. Tudo fica nos seus dispositivos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "通过本地 Wi-Fi 配对，即可借助 Mac 的统一内存运行更大的模型。所有数据都留在你的设备上。"
          }
        }
      }
    },
    "Pair over local Wi-Fi to tap into your Mac's unified memory.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kopple über lokales WLAN, um die Unified Memory deines Mac zu nutzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair over local Wi-Fi to tap into your Mac's unified memory."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Empareja por Wi-Fi local para aprovechar la memoria unificada de tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jumelez via le Wi-Fi local pour exploiter la mémoire unifiée de votre Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अपने Mac की यूनिफ़ाइड मेमोरी का उपयोग करने के लिए लोकल Wi-Fi पर पेयर करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ローカル Wi-Fi でペアリングして、Mac のユニファイドメモリを活用できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pareie pelo Wi-Fi local para aproveitar a memória unificada do seu Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "通过本地 Wi-Fi 配对，即可使用 Mac 的统一内存。"
          }
        }
      }
    },
    "Pair your Mac anytime to run its larger models from your phone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du kannst deinen Mac jederzeit koppeln, um seine größeren Modelle vom Telefon aus auszuführen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair your Mac anytime to run its larger models from your phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Empareja tu Mac cuando quieras para ejecutar sus modelos más grandes desde el teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jumelez votre Mac à tout moment pour exécuter ses modèles plus grands depuis votre téléphone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अपने फ़ोन से Mac के बड़े मॉडल चलाने के लिए उसे कभी भी पेयर कर सकते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mac はいつでもペアリングできます。ペアリングすると、iPhone から Mac の大きいモデルを実行できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pareie seu Mac quando quiser para rodar os modelos maiores dele pelo celular."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你可以随时配对 Mac，从手机上运行它更大的模型。"
          }
        }
      }
    },
