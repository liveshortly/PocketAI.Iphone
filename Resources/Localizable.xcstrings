    "Speech recognition is off for PocketAI. Turn it on in iOS Settings to dictate messages.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recognition is off for PocketAI. Turn it on in iOS Settings to dictate messages."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI के लिए स्पीच रिकग्निशन बंद है। संदेश बोलकर लिखने के लिए इसे iOS सेटिंग्स में चालू करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El reconocimiento de voz está desactivado para PocketAI. Actívalo en los Ajustes de iOS para dictar mensajes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La reconnaissance vocale est désactivée pour PocketAI. Activez-la dans les Réglages iOS pour dicter des messages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Spracherkennung ist für PocketAI ausgeschaltet. Schalten Sie sie in den iOS-Einstellungen ein, um Nachrichten zu diktieren."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAIの音声認識がオフです。メッセージを音声入力するには、iOSの設定でオンにしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
