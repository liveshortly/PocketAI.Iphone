          "stringUnit": {
            "state": "needs_review",
            "value": "重新连接"
          }
        }
      }
    },
    "Reconnect drops this session's discovered address and tests the Mac again. It does not un-pair, so nothing has to be scanned again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„Neu verbinden“ verwirft die in dieser Sitzung gefundene Adresse und prüft den Mac erneut. Die Kopplung bleibt bestehen, es muss nichts neu gescannt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnect drops this session's discovered address and tests the Mac again. It does not un-pair, so nothing has to be scanned again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reconectar descarta la dirección detectada en esta sesión y vuelve a probar el Mac. No deshace el emparejamiento, así que no hay que volver a escanear nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "« Reconnecter » oublie l’adresse détectée pour cette session et teste à nouveau le Mac. Le jumelage est conservé : rien n’est à scanner de nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“फिर कनेक्ट करें” इस सेशन में मिला पता हटाकर Mac की दोबारा जाँच करता है। इससे पेयरिंग नहीं हटती, इसलिए कुछ भी दोबारा स्कैन करने की ज़रूरत नहीं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「再接続」は、このセッションで検出したアドレスを破棄して Mac を再度確認します。ペアリングは解除されないため、もう一度スキャンする必要はありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reconectar descarta o endereço descoberto nesta sessão e testa o Mac novamente. Isso não desfaz o pareamento, então nada precisa ser escaneado de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“重新连接”会放弃本次会话中发现的地址，并重新检测这台 Mac。它不会取消配对，因此无需重新扫描。"
          }
        }
      }
    },
