    "Pairing isn't available right now — the on-device engine didn't start. Restart the app and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Koppeln ist derzeit nicht möglich – die Engine auf dem Gerät wurde nicht gestartet. Starte die App neu und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing isn't available right now — the on-device engine didn't start. Restart the app and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El emparejamiento no está disponible ahora mismo: el motor en el dispositivo no se inició. Reinicia la app e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le jumelage n’est pas disponible pour le moment — le moteur sur l’appareil n’a pas démarré. Redémarrez l’app, puis réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पेयरिंग अभी उपलब्ध नहीं है — डिवाइस पर चलने वाला इंजन शुरू नहीं हुआ। ऐप को रीस्टार्ट करके दोबारा कोशिश करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "現在ペアリングできません。オンデバイスエンジンが起動しませんでした。アプリを再起動してから、もう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O pareamento não está disponível agora — o mecanismo no dispositivo não iniciou. Reinicie o app e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "当前无法配对 — 设备端引擎未启动。请重新启动应用后再试。"
          }
        }
      }
    },
    "Pairing timed out. Make sure your Mac is awake and on the same Wi-Fi, then try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zeitüberschreitung beim Koppeln. Stelle sicher, dass dein Mac aktiv und im selben WLAN ist, und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing timed out. Make sure your Mac is awake and on the same Wi-Fi, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se agotó el tiempo de emparejamiento. Comprueba que tu Mac esté activo y en la misma red Wi-Fi, y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Délai de jumelage dépassé. Vérifiez que votre Mac est allumé et connecté au même réseau Wi-Fi, puis réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पेयरिंग का समय समाप्त हो गया। पक्का करें कि आपका Mac जागा हुआ है और उसी Wi-Fi पर है, फिर दोबारा कोशिश करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ペアリングがタイムアウトしました。Mac がスリープ解除されていて、同じ Wi-Fi に接続されていることを確認してから、もう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O pareamento expirou. Verifique se o seu Mac está ativo e na mesma rede Wi-Fi e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "配对超时。请确认你的 Mac 处于唤醒状态并连接到同一 Wi-Fi，然后重试。"
          }
        }
      }
    },
    "Pairing uses the camera, so it runs from the Mac tab. Everything stays on your devices.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Beim Koppeln wird die Kamera verwendet, daher erfolgt es über den Mac-Tab. Alles bleibt auf deinen Geräten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing uses the camera, so it runs from the Mac tab. Everything stays on your devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El emparejamiento usa la cámara, por lo que se realiza desde la pestaña Mac. Todo permanece en tus dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le jumelage utilise l’appareil photo, il s’effectue donc depuis l’onglet Mac. Tout reste sur vos appareils."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पेयरिंग में कैमरे का उपयोग होता है, इसलिए यह Mac टैब से चलती है। सब कुछ आपके डिवाइस पर ही रहता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ペアリングではカメラを使うため、Mac タブから実行します。すべてお使いのデバイス内に留まります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
