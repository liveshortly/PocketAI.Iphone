    "We read this on your device. It is never sent anywhere.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We read this on your device. It is never sent anywhere."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हम इसे आपके डिवाइस पर ही पढ़ते हैं। इसे कहीं नहीं भेजा जाता।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Leemos esto en tu dispositivo. No se envía a ningún sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nous lisons ceci sur votre appareil. Rien n’est jamais envoyé ailleurs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das lesen wir auf Ihrem Gerät. Es wird nirgendwohin gesendet."
