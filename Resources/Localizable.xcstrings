    "Voice input is transcribed with Apple's Speech framework. When on-device recognition is supported, your audio stays on this iPhone.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice input is transcribed with Apple's Speech framework. When on-device recognition is supported, your audio stays on this iPhone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "वॉइस इनपुट का ट्रांसक्रिप्शन Apple के स्पीच फ़्रेमवर्क से होता है। जब ऑन-डिवाइस पहचान समर्थित हो, तो आपका ऑडियो इसी iPhone पर रहता है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La entrada de voz se transcribe con el framework Speech de Apple. Cuando se admite el reconocimiento en el dispositivo, tu audio se queda en este iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La saisie vocale est transcrite avec le framework Speech d’Apple. Lorsque la reconnaissance sur l’appareil est prise en charge, votre audio reste sur cet iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spracheingaben werden mit Apples Speech-Framework transkribiert. Wenn die Erkennung auf dem Gerät unterstützt wird, bleibt Ihr Audio auf diesem iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "音声入力はAppleのSpeechフレームワークで文字起こしされます。オンデバイス認識に対応している場合、音声はこのiPhoneの外に出ません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "语音输入通过 Apple 的语音框架转写。若支持设备端识别，你的音频将保留在这部 iPhone 上。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A entrada de voz é transcrita com o framework Speech da Apple. Quando há suporte a reconhecimento no dispositivo, seu áudio fica neste iPhone."
          }
        }
      }
    },
