    "This removes it from the project. Adding it back re-extracts and re-indexes it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Damit wird es aus dem Projekt entfernt. Beim erneuten Hinzufügen wird es neu extrahiert und neu indexiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes it from the project. Adding it back re-extracts and re-indexes it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esto lo quita del proyecto. Si lo vuelves a añadir, se extraerá e indexará de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cela le retire du projet. Si vous le rajoutez, il sera réextrait et réindexé."
