    "Add PDF, Markdown, or text files to ground chats in this project.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add PDF, Markdown, or text files to ground chats in this project."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस प्रोजेक्ट की चैट को आधार देने के लिए PDF, Markdown या टेक्स्ट फ़ाइलें जोड़ें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Añade archivos PDF, Markdown o de texto para basar los chats de este proyecto en ellos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajoutez des fichiers PDF, Markdown ou texte pour ancrer les discussions de ce projet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fügen Sie PDF-, Markdown- oder Textdateien hinzu, damit Chats in diesem Projekt darauf basieren."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PDF、Markdown、テキストファイルを追加すると、このプロジェクトのチャットで参照されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "添加 PDF、Markdown 或文本文件，让此项目中的对话以它们为依据。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Adicione arquivos PDF, Markdown ou de texto para embasar as conversas deste projeto."
          }
        }
      }
    },
