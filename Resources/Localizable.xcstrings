            "state": "needs_review",
            "value": "Dieser Modell-Build kann keine Tools verwenden. Wählen Sie unter „Modelle“ einen MLX-Build davon."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このモデルのビルドではツールを使えません。モデルでMLXビルドを選んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
