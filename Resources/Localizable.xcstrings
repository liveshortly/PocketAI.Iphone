    "Mac not reachable. Make sure both are on the same Wi-Fi, or enter the address.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mac nicht erreichbar. Stelle sicher, dass beide im selben Wi-Fi sind, oder gib die Adresse ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac not reachable. Make sure both are on the same Wi-Fi, or enter the address."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se puede acceder al Mac. Comprueba que ambos estén en la misma red Wi-Fi o introduce la dirección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mac inaccessible. Vérifiez que les deux sont sur le même réseau Wi-Fi ou saisissez l'adresse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mac तक नहीं पहुँच सके। पक्का करें कि दोनों एक ही Wi-Fi पर हैं, या पता दर्ज करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mac に接続できません。両方が同じ Wi-Fi に接続されていることを確認するか、アドレスを入力してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mac inacessível. Verifique se os dois estão na mesma rede Wi-Fi ou digite o endereço."
