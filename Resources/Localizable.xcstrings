    "Lets the assistant run JavaScript or Python in a sandbox. You approve every run. Change it anytime in Settings → Tools.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets the assistant run JavaScript or Python in a sandbox. You approve every run. Change it anytime in Settings → Tools."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "असिस्टेंट को सैंडबॉक्स में JavaScript या Python चलाने देता है। हर बार चलाने की मंज़ूरी आप देते हैं। इसे कभी भी सेटिंग्स → टूल्स में बदलें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permite que el asistente ejecute JavaScript o Python en un entorno aislado. Tú apruebas cada ejecución. Cámbialo cuando quieras en Ajustes → Herramientas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permet à l’assistant d’exécuter du JavaScript ou du Python dans un bac à sable. Vous approuvez chaque exécution. Modifiable à tout moment dans Réglages → Outils."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Erlaubt dem Assistenten, JavaScript oder Python in einer Sandbox auszuführen. Sie genehmigen jede Ausführung. Jederzeit änderbar unter Einstellungen → Tools."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "アシスタントがサンドボックス内でJavaScriptやPythonを実行できるようになります。実行のたびに承認が必要です。設定 → ツールでいつでも変更できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "允许助手在沙盒中运行 JavaScript 或 Python。每次运行都需要你批准。你可随时在“设置 → 工具”中更改。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permite que o assistente execute JavaScript ou Python em um sandbox. Você aprova cada execução. Mude isso quando quiser em Ajustes → Ferramentas."
          }
        }
      }
    },
