    "The on-device engine couldn't start. Your chats and models are safe on this iPhone. Quit and reopen PocketAI to try again.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The on-device engine couldn't start. Your chats and models are safe on this iPhone. Quit and reopen PocketAI to try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ऑन-डिवाइस इंजन शुरू नहीं हो सका। आपकी चैट और मॉडल इस iPhone पर सुरक्षित हैं। फिर कोशिश करने के लिए PocketAI बंद करके दोबारा खोलें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se pudo iniciar el motor del dispositivo. Tus chats y modelos están a salvo en este iPhone. Cierra y vuelve a abrir PocketAI para intentarlo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le moteur sur l’appareil n’a pas pu démarrer. Vos discussions et vos modèles sont en sécurité sur cet iPhone. Quittez puis rouvrez PocketAI pour réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Engine auf dem Gerät konnte nicht gestartet werden. Ihre Chats und Modelle sind auf diesem iPhone sicher. Beenden Sie PocketAI und öffnen Sie es erneut, um es noch einmal zu versuchen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "オンデバイスエンジンを起動できませんでした。チャットとモデルはこのiPhoneに安全に保存されています。PocketAIを終了して開き直してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "设备端引擎无法启动。你的对话和模型在这部 iPhone 上安然无恙。请退出并重新打开 PocketAI 再试一次。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O mecanismo no dispositivo não conseguiu iniciar. Suas conversas e modelos estão seguros neste iPhone. Feche e reabra o PocketAI para tentar novamente."
          }
        }
      }
    },
    "They're removed from PocketAI. Share them again to add them later.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They're removed from PocketAI. Share them again to add them later."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "वे PocketAI से हटा दिए गए हैं। बाद में जोड़ने के लिए उन्हें फिर से साझा करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se quitan de PocketAI. Vuelve a compartirlos para añadirlos más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ils sont retirés de PocketAI. Partagez-les de nouveau pour les ajouter plus tard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sie werden aus PocketAI entfernt. Teilen Sie sie später erneut, um sie wieder hinzuzufügen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAIから削除されます。後で追加するには、もう一度共有してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "它们已从 PocketAI 中移除。之后如需添加，请再次共享。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eles são removidos do PocketAI. Compartilhe-os novamente para adicioná-los depois."
          }
        }
      }
    },
