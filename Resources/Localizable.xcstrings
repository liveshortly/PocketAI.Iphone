    "You can pair again anytime by scanning the code on your Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du kannst jederzeit erneut koppeln, indem du den Code auf deinem Mac scannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can pair again anytime by scanning the code on your Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Puedes volver a emparejar en cualquier momento escaneando el código en tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous pouvez jumeler à nouveau à tout moment en scannant le code sur votre Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आप अपने Mac पर दिखाए गए कोड को स्कैन करके कभी भी फिर से पेयर कर सकते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Macに表示されるコードを読み取れば、いつでも再度ペアリングできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Você pode pareá-lo novamente a qualquer momento escaneando o código no seu Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你可以随时扫描 Mac 上显示的代码重新配对。"
          }
        }
      }
    },
    "You can switch or download other models anytime in the Models tab.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du kannst im Tab „Modelle“ jederzeit andere Modelle auswählen oder laden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can switch or download other models anytime in the Models tab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Puedes cambiar de modelo o descargar otros en cualquier momento en la pestaña Modelos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous pouvez changer de modèle ou en télécharger d'autres à tout moment dans l'onglet Modèles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आप कभी भी मॉडल टैब में दूसरे मॉडल पर स्विच कर सकते हैं या उन्हें डाउनलोड कर सकते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「モデル」タブでは、いつでも他のモデルに切り替えたりダウンロードしたりできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Você pode trocar ou baixar outros modelos a qualquer momento na aba Modelos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你可以随时在“模型”标签页切换或下载其他模型。"
